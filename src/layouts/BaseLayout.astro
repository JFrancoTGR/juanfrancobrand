---
import '../styles/global.css';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import RevealController from '../components/global/RevealController.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='color-scheme' content='light' />
    <meta name='theme-color' content='#f7f7f5' />
    <meta name='description' content={description} />
    <title>{title}</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Geist:wght@300;400;900&display=swap'
      rel='stylesheet'
    />
  </head>
  <body>
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter />
    <RevealController />
  </body>
</html>
