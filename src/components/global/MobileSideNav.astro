---
import { navigation } from '../../data/site';
---

<div class='mobile-side-nav' id='mobile-side-nav' data-expanded='false'>
  <!-- FONDO PARA CERRAR EL MENÚ -->

  <button
    class='mobile-nav-backdrop'
    id='mobile-nav-backdrop'
    type='button'
    aria-label='Cerrar menú'
    tabindex='-1'></button>

  <!-- BARRA LATERAL -->

  <aside class='mobile-rail'>
    <!-- HAMBURGUESA -->

    <button
      class='mobile-nav-toggle'
      id='mobile-nav-toggle'
      type='button'
      aria-label='Expandir menú'
      aria-expanded='false'
      aria-controls='mobile-nav-links'
    >
      <svg
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='1.6'
        stroke-linecap='round'
        aria-hidden='true'
      >
        <path class='hamburger-open' d='M4 8h16 M4 16h16'></path>

        <path class='hamburger-close' d='M5 5l14 14 M19 5L5 19'></path>
      </svg>

      <span class='mobile-nav-label' aria-hidden='true'> Menú </span>
    </button>

    <!-- ENLACES -->

    <nav
      class='mobile-rail-nav'
      id='mobile-nav-links'
      aria-label='Navegación móvil'
    >
      {
        navigation.map((item) => (
          <a class='mobile-nav-link' href={item.href} aria-label={item.label}>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.6'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              {item.href === '#enfoque' && (
                <>
                  <circle cx='12' cy='12' r='8' />
                  <circle cx='12' cy='12' r='2.5' />
                </>
              )}

              {item.href === '#soluciones' && (
                <>
                  <rect x='3' y='5' width='7' height='7' rx='1' />
                  <rect x='14' y='12' width='7' height='7' rx='1' />
                  <path d='M10 8.5h4v7' />
                </>
              )}

              {item.href === '#resultados' && (
                <>
                  <path d='M3 20h18' />
                  <rect x='4' y='12' width='3' height='8' rx='0.7' />
                  <rect x='10.5' y='8' width='3' height='12' rx='0.7' />
                  <rect x='17' y='4' width='3' height='16' rx='0.7' />
                </>
              )}

              {item.href === '#stack' && (
                <>
                  <path d='M4 7l8-4 8 4-8 4z' />
                  <path d='M4 12l8 4 8-4' />
                  <path d='M4 17l8 4 8-4' />
                </>
              )}

              {item.href === '#trayectoria' && (
                <>
                  <path d='M6 3v18' />
                  <circle cx='6' cy='6' r='2' />
                  <circle cx='6' cy='12' r='2' />
                  <circle cx='6' cy='18' r='2' />
                  <path d='M9 6h10 M9 12h7 M9 18h10' />
                </>
              )}

              {item.href === '#contacto' && (
                <>
                  <path d='M20 11.5a8 8 0 0 1-8 8 8.8 8.8 0 0 1-3.5-.8L4 20l1.3-4.5A8 8 0 1 1 20 11.5z' />
                  <path d='M8 11.5h8' />
                </>
              )}
            </svg>

            <span class='mobile-nav-label' aria-hidden='true'>
              {item.label}
            </span>
          </a>
        ))
      }
    </nav>
  </aside>
</div>

<script>
  import { initMobileSideNav } from '../../scripts/mobileSideNav';

  initMobileSideNav();
</script>

<style>
  /* DESKTOP: COMPLETAMENTE OCULTO */

  .mobile-side-nav {
    display: none;
  }

  /* MOBILE */

  @media (max-width: 780px) {
    .mobile-side-nav {
      display: block;
    }

    /* BACKDROP */

    .mobile-nav-backdrop {
      position: fixed;
      inset: 0;

      z-index: 55;

      width: 100%;
      height: 100%;

      border: 0;
      background: rgba(25, 25, 25, 0.28);

      opacity: 0;
      visibility: hidden;
      pointer-events: none;

      transition:
        opacity 0.25s var(--ease),
        visibility 0.25s;
    }

    .mobile-side-nav[data-expanded='true'] .mobile-nav-backdrop {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    /* RAIL */

    .mobile-rail {
      position: fixed;

      top: 70px;
      left: 0;
      bottom: 0;

      z-index: 60;

      width: var(--mobile-rail-width);

      background: var(--paper);

      border-right: 1px solid var(--rule);

      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;

      padding: 14px 0 max(20px, env(safe-area-inset-bottom));

      transition: width 0.24s var(--ease);
    }

    .mobile-side-nav[data-expanded='true'] .mobile-rail {
      width: min(260px, calc(100vw - 48px));
    }

    /* ELEMENTOS INTERACTIVOS */

    .mobile-nav-toggle,
    .mobile-nav-link {
      position: relative;

      display: flex;
      align-items: center;

      width: 100%;
      min-height: 48px;

      padding: 0 12px;
      gap: 16px;

      border: 0;
      background: transparent;

      color: var(--ink);

      text-align: left;
      text-decoration: none;

      cursor: pointer;
      touch-action: manipulation;
    }

    .mobile-nav-toggle svg,
    .mobile-nav-link svg {
      display: block;

      width: 22px;
      height: 22px;

      flex: 0 0 22px;
    }

    /* HAMBURGUESA */

    .mobile-nav-toggle {
      margin-bottom: 35px;
    }

    .hamburger-close {
      display: none;
    }

    .mobile-side-nav[data-expanded='true'] .hamburger-open {
      display: none;
    }

    .mobile-side-nav[data-expanded='true'] .hamburger-close {
      display: block;
    }

    /* LINKS */

    .mobile-rail-nav {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .mobile-nav-link {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.02em;

      transition:
        color 0.2s,
        background 0.2s;
    }

    /* ACTIVE STATE */

    .mobile-nav-link.active {
      color: var(--ink);
      background: rgba(216, 229, 87, 0.12);
    }

    .mobile-nav-link.active::before {
      content: '';

      position: absolute;
      left: 0;
      top: 8px;
      bottom: 8px;

      width: 3px;

      background: var(--accent);

      border-radius: 0 3px 3px 0;
    }

    /* LABELS */

    .mobile-nav-label {
      opacity: 0;

      white-space: nowrap;

      transform: translateX(-6px);

      transition:
        opacity 0.18s ease,
        transform 0.18s ease;

      pointer-events: none;
    }

    .mobile-side-nav[data-expanded='true'] .mobile-nav-label {
      opacity: 1;
      transform: translateX(0);

      transition-delay: 0.06s;
    }

    /* TOUCH FEEDBACK */

    .mobile-nav-toggle:active,
    .mobile-nav-link:active {
      background: rgba(66, 66, 66, 0.08);
    }

    /* FOCUS */

    .mobile-nav-toggle:focus-visible,
    .mobile-nav-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -3px;
    }
  }
</style>
