---
import { site } from '../../data/site';
---

<section class='hero shell' id='inicio' aria-labelledby='hero-title'>
  <div class='hero-top eyebrow quiet'>
    <span>Desarrollo / Integración / Consultoría</span><span class='right-note'
      >{site.location} &nbsp;·&nbsp; {new Date().getFullYear()}</span>
  </div>
  <div class='hero-copy' data-reveal>
    <h1 id='hero-title'>
      <span class='line'>Desarrollo<span class='period'>.</span></span>
      <span class='line light'>Conecto<span class='period'>.</span></span>
      <span class='line'
        ><span class='last'>Automatizo<span class='period'>.</span></span><a
          class='hero-stamp'
          href='#enfoque'
          aria-label='Explorar mi enfoque'><span class='circle'>↗</span></a
        ></span
      >
    </h1>
  </div>
  <div class='hero-bottom' data-reveal>
    <div class='hero-role'>
      <span class='eyebrow quiet'>{site.fullName}</span><br /><br />{
        site.role
      }<br />{site.specialties}
    </div>
    <p class='hero-description'>
      Diseño sistemas que conectan información, procesos y personas. Del
      concepto visual a la arquitectura que permite que todo funcione.
    </p>
    <a class='hero-scroll' href='#enfoque'
      ><span>Explorar</span><span class='down-icon' aria-hidden='true'>↓</span
      ></a
    >
  </div>
</section>
<style>
  .hero {
    min-height: min(930px, 100svh);
    padding-top: 146px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }
  .hero-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 23px 0 38px;
    border-top: 1px solid var(--rule);
    gap: 40px;
  }
  .hero-top .right-note {
    text-align: right;
  }
  .hero-copy {
    padding-top: clamp(38px, 7vh, 85px);
    position: relative;
  }
  .hero-copy h1 {
    font-size: clamp(75px, 11.6vw, 188px);
    letter-spacing: -0.102em;
    line-height: 0.91;
    font-weight: 900;
    margin: 0;
    max-width: 1350px;
  }
  .hero-copy h1 .line {
    display: block;
    white-space: nowrap;
  }
  .hero-copy h1 .light {
    font-weight: 300;
    letter-spacing: -0.11em;
  }
  .hero-copy h1 .last {
    display: inline-block;
    position: relative;
  }
  .hero-copy h1 .period {
    color: var(--accent);
  }
  .hero-stamp {
    display: inline-flex;
    align-items: center;
    margin-left: clamp(15px, 2vw, 40px);
    vertical-align: 24%;
  }
  .hero-stamp .circle {
    border: 1px solid var(--ink);
    width: clamp(44px, 6vw, 94px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transform: rotate(45deg);
    font-size: clamp(18px, 2.2vw, 34px);
    font-weight: 300;
    letter-spacing: 0;
    transition:
      background 0.25s,
      transform 0.45s var(--ease);
  }
  .hero-stamp:hover .circle {
    background: var(--accent);
    transform: rotate(135deg);
  }
  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(200px, 0.8fr) 1.5fr minmax(125px, 0.45fr);
    align-items: end;
    gap: 42px;
    padding-top: 70px;
    padding-bottom: 38px;
  }
  .hero-role {
    max-width: 195px;
    font-size: 13px;
    line-height: 1.55;
  }
  .hero-description {
    font-size: clamp(19px, 2.35vw, 31px);
    line-height: 1.34;
    font-weight: 300;
    letter-spacing: -0.045em;
    margin: 0;
    max-width: 675px;
  }
  .hero-scroll {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }
  .down-icon {
    height: 43px;
    width: 43px;
    border: 1px solid #ababab;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 20px;
    transition:
      transform 0.3s,
      background 0.3s;
  }
  .hero-scroll:hover .down-icon {
    transform: translateY(5px);
    background: var(--accent);
  }
  .hero [data-reveal] {
    transition-delay: 0.1s;
  }
  @media (max-width: 1140px) {
    .hero-copy h1 {
      font-size: clamp(72px, 11.9vw, 140px);
    }
    .hero {
      min-height: 800px;
    }
    .hero-bottom {
      grid-template-columns: 1fr 1.5fr;
    }
    .hero-scroll {
      display: none;
    }
  }
  @media (max-width: 780px) {
    .hero {
      min-height: unset;
      padding-top: 104px;
    }
    .hero-top {
      padding: 14px 0 0;
    }
    .hero-top .right-note {
      display: none;
    }
    .hero-copy {
      padding-top: 95px;
      padding-bottom: 60px;
    }
    .hero-copy h1 {
      font-size: clamp(64px, 13.1vw, 102px);
      letter-spacing: -0.1em;
    }
    .hero-stamp {
      margin-left: 10px;
    }
    .hero-stamp .circle {
      width: 44px;
      font-size: 17px;
    }
    .hero-bottom {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 34px 0 52px;
      border-top: 1px solid var(--rule);
    }
    .hero-role {
      max-width: 100%;
    }
    .hero-description {
      font-size: 22px;
    }
  }
  @media (max-width: 450px) {
    .hero-copy h1 {
      font-size: clamp(50px, 13.4vw, 68px);
    }
    .hero-copy {
      padding-top: 100px;
      padding-bottom: 60px;
    }
    .hero-stamp .circle {
      width: 35px;
      font-size: 15px;
    }
    .hero-stamp {
      margin-left: 6px;
      vertical-align: 18%;
    }
  }
</style>
