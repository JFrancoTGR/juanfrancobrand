---
interface Props {
  number: string;
  title: string;
  subtitle: string;
}
const { number, title, subtitle } = Astro.props;
---

<div class='chapter-top eyebrow' data-reveal>
  <div class='chapter-id'>
    <span class='num'>{number}</span><span class='chapter-title-sm'
      >{title}</span>
  </div>
  <span class='chapter-suffix quiet'>{subtitle}</span>
</div>
