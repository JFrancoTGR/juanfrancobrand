---
import { workingMethod } from '../../data/content';
---

<div class='method-strip' data-reveal aria-label='Forma de trabajo'>
  <span class='method-label eyebrow'>Método de trabajo</span>
  {
    workingMethod.map((step, i) => (
      <div>
        <>
          <span>{String(i + 1).padStart(2, '0')}</span>
          <strong>{step.title}</strong>
          <small>{step.detail}</small>
        </>
      </div>
    ))
  }
</div>
<style>
  .method-strip {
    display: grid;
    grid-template-columns: 0.95fr repeat(4, 1fr);
    margin-top: 78px;
    border-top: 1px solid #686868;
    border-bottom: 1px solid #686868;
  }
  .method-strip > div {
    padding: 28px 17px 28px 25px;
    border-left: 1px solid #686868;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .method-strip .method-label {
    padding: 30px 20px 0 0;
    color: #cececa;
  }
  .method-strip div span {
    color: var(--accent);
    font-size: 10px;
  }
  .method-strip strong {
    font-size: 18px;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  .method-strip small {
    font-size: 11px;
    line-height: 1.6;
    color: #cececa;
  }
  @media (max-width: 900px) {
    .method-strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .method-strip .method-label {
      grid-column: 1 / -1;
      padding: 20px 0;
    }
    .method-strip > div {
      border-top: 1px solid #686868;
    }
    .method-strip > div:nth-child(2n) {
      border-left: 0;
    }
  }
  @media (max-width: 450px) {
    .method-strip strong {
      font-size: 16px;
    }
    .method-strip > div {
      padding: 20px 12px;
    }
  }
</style>
